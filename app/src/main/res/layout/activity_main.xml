<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="1971sportswear" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Baixador de Capas • Completo v3" android:textSize="15sp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/url" android:hint="Cole a URL da categoria" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/onlyFirst" android:text="Somente primeira imagem" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/square" android:text="Padronizar em 1000 × 1000" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/white" android:text="Fundo branco" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/analisar" android:text="1 • ANALISAR PRODUTOS" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/baixar" android:text="2 • BAIXAR CAPAS SELECIONADAS" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/zip" android:text="3 • GERAR ZIP" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Pronto." android:textSize="15sp" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/lista" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
